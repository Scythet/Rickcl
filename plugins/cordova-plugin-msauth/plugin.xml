<?xml version='1.0' encoding='utf-8'?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    id="cordova-plugin-msauth"
    version="1.0.0">

    <name>MSAuth</name>
    <description>Login real de Microsoft/Xbox/Minecraft para Rickcl</description>

    <js-module src="www/msauth.js" name="MSAuth">
        <clobbers target="cordova.plugins.MSAuth" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="MSAuth">
                <param name="android-package" value="com.rickcl.msauth.MSAuthPlugin" />
            </feature>
        </config-file>

        <framework src="com.squareup.okhttp3:okhttp:4.12.0" />
        <framework src="org.jetbrains.kotlinx:kotlinx-coroutines-android:1.8.1" />

        <source-file src="src/android/MicrosoftAuth.kt" target-dir="src/com/rickcl/msauth" />
        <source-file src="src/android/MSAuthPlugin.kt" target-dir="src/com/rickcl/msauth" />
    </platform>
</plugin>
